# HubCmdUI 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# HTTP 代理配置 (用于所有出站请求)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
# Docker Compose 部署时应排除内部服务名，避免管理接口请求误走出口代理
# NO_PROXY=localhost,127.0.0.1,::1,go-proxy,reg-go-proxy,hubcmd-ui,.local

# 如果代理需要用户名和密码认证
# HTTP_PROXY=http://username:password@proxy.example.com:8080
# HTTPS_PROXY=https://username:password@proxy.example.com:8080


# 真实宿主机名 (仪表盘「主机」展示用)
# 留空时容器内默认返回容器 ID; 可填入宿主机真实主机名,
# 或启动时用 HOST_NAME=$(hostname) docker compose up -d 传入。
HOST_NAME=

# 服务器配置
PORT=3000

# 会话密钥
SESSION_SECRET=OhTq3faqSKoxbV%NJV

# 服务器端口
PORT=3000

# Registry 标签详情性能参数（Docker Compose 部署时也可在项目根目录 .env 配置）
# REGISTRY_TAG_CACHE_TTL_MS=1800000
# REGISTRY_TAG_METADATA_CONCURRENCY=8
# REGISTRY_TAGS_MAX=5000
# REGISTRY_CACHE_MAX_ENTRIES=512
# REGISTRY_TOKEN_CACHE_MAX_ENTRIES=256
# REGISTRY_CACHE_CLEANUP_INTERVAL_MS=60000
